.page {
  min-height: 100vh;
  background: var(--bg-secondary);
  padding-bottom: 200rpx;
}

.container {
  padding: var(--spacing-md);
}

.header-card {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  border-radius: var(--radius-lg);
  padding: 32rpx;
  color: white;
  margin-bottom: var(--spacing-md);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.header-icon {
  font-size: 60rpx;
}

.header-text {
  flex: 1;
}

.header-title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: var(--font-size-sm);
  opacity: 0.9;
}

.apply-all-btn {
  width: 100%;
  height: 88rpx;
  background: white;
  color: var(--primary-color);
  border: none;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.apply-all-btn:active {
  transform: scale(0.98);
}

.quick-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: var(--spacing-md);
}

.quick-btn {
  flex: 1;
  background: white;
  border-radius: var(--radius-md);
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: var(--shadow-sm);
}

.quick-icon {
  font-size: 36rpx;
}

.quick-text {
  font-size: var(--font-size-md);
  color: var(--text-primary);
}

.timeline-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.timeline-item {
  overflow: hidden;
  transition: all 0.3s ease;
}

.timeline-item:active {
  transform: scale(0.99);
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.timeline-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.timeline-icon {
  font-size: 48rpx;
}

.timeline-content {
  flex: 1;
}

.timeline-name {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.timeline-count {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

.timeline-expand {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.expand-icon {
  font-size: 32rpx;
  color: var(--text-tertiary);
  transition: transform 0.3s ease;
}

.expand-icon.expanded {
  transform: rotate(90deg);
}

.timeline-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.timeline-body.show {
  max-height: 2000rpx;
}

.checklist-items {
  padding: 0 0 24rpx 0;
  border-top: 2rpx solid var(--bg-secondary);
}

.checklist-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  gap: 12rpx;
}

.item-bullet {
  color: var(--primary-color);
  font-size: 24rpx;
  flex-shrink: 0;
}

.item-title {
  flex: 1;
  font-size: var(--font-size-md);
  color: var(--text-primary);
}

.item-tag {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  flex-shrink: 0;
}

.item-tag.tag-high {
  background: #FFF1F0;
  color: var(--error-color);
}

.item-tag.tag-medium {
  background: #FFF7E6;
  color: var(--warning-color);
}

.item-tag.tag-low {
  background: #E6F7E6;
  color: var(--success-color);
}

.timeline-actions {
  padding-top: 16rpx;
  border-top: 2rpx solid var(--bg-secondary);
}

.apply-btn {
  width: 100%;
  height: 80rpx;
  background: var(--primary-light);
  color: var(--primary-color);
  border: none;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.apply-btn:active {
  transform: scale(0.98);
  background: var(--primary-color);
  color: white;
}
