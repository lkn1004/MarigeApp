.page {
  min-height: 100vh;
  background: var(--bg-secondary);
  padding-bottom: 200rpx;
}

.stats-card {
  background: white;
  padding: 32rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.stat-value.confirmed {
  color: var(--success-color);
}

.stat-value.pending {
  color: var(--warning-color);
}

.stat-value.declined {
  color: var(--error-color);
}

.stat-label {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--border-color);
}

.search-bar {
  background: white;
  padding: 24rpx 32rpx;
  box-shadow: var(--shadow-sm);
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: var(--bg-secondary);
  border-radius: var(--radius-full);
  padding: 16rpx 24rpx;
}

.search-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.search-input {
  flex: 1;
  font-size: var(--font-size-md);
}

.filter-section {
  background: white;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.filter-group {
  padding: 0 32rpx;
}

.filter-label {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-tags {
  display: inline-flex;
  gap: 12rpx;
}

.filter-tag {
  padding: 10rpx 20rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  white-space: nowrap;
}

.filter-tag.active {
  background: var(--primary-color);
  color: white;
}

.guest-container {
  padding: var(--spacing-md);
}

.guest-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.guest-card {
  transition: all 0.2s ease;
}

.guest-card:active {
  transform: scale(0.98);
}

.guest-main {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.guest-status {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  border: 3rpx solid var(--border-color);
  color: var(--text-tertiary);
}

.guest-status.confirmed {
  background: var(--success-color);
  border-color: var(--success-color);
  color: white;
}

.guest-status.declined {
  background: var(--error-color);
  border-color: var(--error-color);
  color: white;
}

.guest-status.pending,
.guest-status.sent {
  border-color: var(--warning-color);
  color: var(--warning-color);
}

.guest-content {
  flex: 1;
  min-width: 0;
}

.guest-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.guest-name {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.guest-attendant {
  font-size: 24rpx;
}

.guest-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.meta-separator {
  color: var(--text-tertiary);
}

.guest-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.guest-tag {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  background: var(--bg-secondary);
  color: var(--text-secondary);
}

.guest-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--bg-secondary);
}

.action-btn {
  padding: 8rpx 16rpx;
  font-size: 28rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
}

.action-btn.delete {
  background: #FFF1F0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: var(--font-size-lg);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

.fab {
  position: fixed;
  bottom: 160rpx;
  right: 40rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 60rpx;
  font-weight: 300;
  box-shadow: var(--shadow-lg);
  z-index: 100;
}

.fab:active {
  transform: scale(0.95);
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: none;
  align-items: flex-end;
  justify-content: center;
}

.modal.show {
  display: flex;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 100%;
  max-height: 90vh;
  background: white;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  overflow-y: auto;
  animation: slideUp 0.3s ease-out;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid var(--border-color);
  position: sticky;
  top: 0;
  background: white;
  z-index: 1;
}

.modal-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
}

.modal-close {
  font-size: 48rpx;
  color: var(--text-tertiary);
}

.modal-body {
  padding: 32rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid var(--border-color);
  position: sticky;
  bottom: 0;
  background: white;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.cancel {
  background: var(--bg-secondary);
  color: var(--text-secondary);
}

.modal-btn.confirm {
  background: var(--primary-color);
  color: white;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-item.half {
  flex: 1;
}

.form-label {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  box-sizing: border-box;
}

.form-textarea {
  min-height: 100rpx;
  resize: vertical;
}

.group-options,
.status-options {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.group-option,
.status-option {
  padding: 12rpx 24rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  border: 2rpx solid transparent;
}

.group-option.selected {
  background: var(--primary-color);
  color: white;
}

.attendant-item {
  margin-bottom: 24rpx;
}

.attendant-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.attendant-row .form-label {
  margin-bottom: 0;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
