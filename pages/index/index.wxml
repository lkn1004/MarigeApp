<view class="page">
  <!-- 引导页 -->
  <view class="onboarding-modal" wx:if="{{showOnboarding}}">
    <view class="onboarding-content">
      <view class="onboarding-header">
        <text class="onboarding-icon">💒</text>
        <text class="onboarding-title">欢迎使用备婚助手</text>
        <text class="onboarding-subtitle">让婚礼筹备变得轻松愉快</text>
      </view>
      
      <view class="onboarding-features">
        <view class="feature-item">
          <text class="feature-icon">📋</text>
          <text class="feature-text">待办清单 - 合理规划每一步</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">📅</text>
          <text class="feature-text">日历视图 - 掌握重要时间节点</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">💰</text>
          <text class="feature-text">预算管理 - 精打细算每一分</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">⏰</text>
          <text class="feature-text">倒计时 - 期待每一天</text>
        </view>
      </view>
      
      <button class="onboarding-button" bindtap="startOnboarding">开始设置</button>
    </view>
  </view>

  <!-- 主内容区 -->
  <view class="container" wx:if="{{!showOnboarding}}">
    <!-- 婚礼倒计时卡片 -->
    <view class="countdown-card">
      <view class="countdown-header">
        <text class="countdown-label">距离婚礼还有</text>
        <text class="countdown-days">{{daysUntilWedding}}</text>
        <text class="countdown-unit">天</text>
      </view>
      
      <view class="couple-names" wx:if="{{groomName || brideName}}">
        <text class="name">{{groomName}}</text>
        <text class="separator">&</text>
        <text class="name">{{brideName}}</text>
      </view>
      
      <view class="wedding-date" wx:if="{{weddingDate}}">
        <text>{{weddingDate}}</text>
      </view>
    </view>

    <!-- 进度概览 -->
    <view class="progress-section card">
      <view class="section-header">
        <text class="section-title">筹备进度</text>
        <text class="progress-text">{{progress}}%</text>
      </view>
      
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progress}}%"></view>
      </view>
      
      <view class="progress-stats">
        <view class="stat-item">
          <text class="stat-value">{{quickStats.completedTodos}}</text>
          <text class="stat-label">已完成</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{quickStats.totalTodos}}</text>
          <text class="stat-label">总任务</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{quickStats.totalTodos - quickStats.completedTodos}}</text>
          <text class="stat-label">待完成</text>
        </view>
      </view>
    </view>

    <!-- 今日待办 -->
    <view class="today-section card" wx:if="{{todayTodos.length > 0}}">
      <view class="section-header flex-between">
        <text class="section-title">今日待办</text>
        <view class="more-btn" bindtap="goToTodo">
          <text>查看全部</text>
          <text class="arrow">›</text>
        </view>
      </view>
      
      <view class="todo-list">
        <view 
          class="todo-item" 
          wx:for="{{todayTodos}}" 
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="completeTodo"
        >
          <view class="todo-checkbox {{item.completed ? 'checked' : ''}}">
            <text wx:if="{{item.completed}}">✓</text>
          </view>
          <view class="todo-content">
            <text class="todo-title {{item.completed ? 'completed' : ''}}">{{item.title}}</text>
            <text class="todo-category tag tag-primary">{{item.categoryName}}</text>
          </view>
          <view class="priority-dot priority-{{item.priority}}"></view>
        </view>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="quick-actions card">
      <view class="action-item" bindtap="goToTodo">
        <view class="action-icon" style="background: #F5E6E8;">
          <text>📋</text>
        </view>
        <text class="action-text">待办事项</text>
      </view>
      
      <view class="action-item" bindtap="goToCalendar">
        <view class="action-icon" style="background: #E6F7E6;">
          <text>📅</text>
        </view>
        <text class="action-text">日历</text>
      </view>
      
      <view class="action-item" bindtap="goToBudget">
        <view class="action-icon" style="background: #FFF7E6;">
          <text>💰</text>
        </view>
        <text class="action-text">预算</text>
      </view>
      
      <view class="action-item" bindtap="goToSettings">
        <view class="action-icon" style="background: #E6F0FF;">
          <text>⚙️</text>
        </view>
        <text class="action-text">设置</text>
      </view>
    </view>

    <!-- 预算概览 -->
    <view class="budget-section card" wx:if="{{quickStats.totalBudget > 0}}">
      <view class="section-header">
        <text class="section-title">预算概览</text>
        <text class="budget-action" bindtap="goToBudget">详情 ›</text>
      </view>
      
      <view class="budget-info">
        <view class="budget-amount">
          <text class="amount-label">已花费</text>
          <text class="amount-value">{{formatCurrency(quickStats.spentBudget)}}</text>
        </view>
        <view class="budget-divider"></view>
        <view class="budget-amount">
          <text class="amount-label">总预算</text>
          <text class="amount-value">{{formatCurrency(quickStats.totalBudget)}}</text>
        </view>
      </view>
      
      <view class="budget-progress">
        <view class="progress-bar">
          <view 
            class="progress-fill {{quickStats.spentBudget > quickStats.totalBudget * 0.9 ? 'warning' : ''}}" 
            style="width: {{quickStats.totalBudget > 0 ? Math.min((quickStats.spentBudget / quickStats.totalBudget) * 100, 100) : 0}}%"
          ></view>
        </view>
        <text class="budget-percentage">
          {{quickStats.totalBudget > 0 ? Math.round((quickStats.spentBudget / quickStats.totalBudget) * 100) : 0}}%
        </text>
      </view>
    </view>

    <!-- 宾客统计 -->
    <view class="guest-section card" wx:if="{{quickStats.guestCount > 0}}">
      <view class="section-header">
        <text class="section-title">宾客统计</text>
      </view>
      
      <view class="guest-info">
        <view class="guest-item">
          <text class="guest-count">{{quickStats.confirmedGuests}}</text>
          <text class="guest-label">已确认</text>
        </view>
        <view class="guest-divider"></view>
        <view class="guest-item">
          <text class="guest-count">{{quickStats.guestCount}}</text>
          <text class="guest-label">总人数</text>
        </view>
      </view>
    </view>

    <!-- 最近动态 -->
    <view class="recent-section card" wx:if="{{recentTodos.length > 0}}">
      <view class="section-header">
        <text class="section-title">最近完成</text>
      </view>
      
      <view class="recent-list">
        <view class="recent-item" wx:for="{{recentTodos}}" wx:key="id">
          <view class="recent-icon">
            <text>✓</text>
          </view>
          <view class="recent-content">
            <text class="recent-title">{{item.title}}</text>
            <text class="recent-time">{{item.completedAt}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
