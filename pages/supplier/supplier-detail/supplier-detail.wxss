.page { min-height: 100vh; background: var(--bg-secondary); }
.container { padding: var(--spacing-md); }
.detail-card { background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); border-radius: var(--radius-lg); padding: 40rpx; color: white; margin-bottom: var(--spacing-md); }
.supplier-name { font-size: 40rpx; font-weight: 600; margin-bottom: 8rpx; }
.supplier-type { font-size: var(--font-size-sm); opacity: 0.9; }
.info-card { background: white; border-radius: var(--radius-md); padding: var(--spacing-md); margin-bottom: var(--spacing-md); }
.info-item { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 2rpx solid var(--bg-secondary); }
.info-item:last-child { border-bottom: none; }
.info-label { font-size: var(--font-size-sm); color: var(--text-secondary); }
.info-value { font-size: var(--font-size-md); color: var(--text-primary); }
.info-value.price { color: var(--error-color); font-weight: 600; }
.notes-card { background: white; border-radius: var(--radius-md); padding: var(--spacing-md); }
.notes-title { font-size: var(--font-size-sm); color: var(--text-secondary); display: block; margin-bottom: 12rpx; }
.notes-content { font-size: var(--font-size-md); color: var(--text-primary); line-height: 1.6; }
