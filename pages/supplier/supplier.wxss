.page {
  min-height: 100vh;
  background: var(--bg-secondary);
  padding-bottom: 200rpx;
}

.search-bar {
  background: white;
  padding: 24rpx 32rpx;
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: var(--bg-secondary);
  border-radius: var(--radius-full);
  padding: 16rpx 24rpx;
}

.search-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.search-input {
  flex: 1;
  font-size: var(--font-size-md);
}

.type-filter {
  background: white;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.filter-scroll {
  white-space: nowrap;
}

.filter-tags {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 32rpx;
}

.filter-tag {
  padding: 12rpx 24rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  white-space: nowrap;
}

.filter-tag.active {
  background: var(--primary-color);
  color: white;
}

.supplier-container {
  padding: var(--spacing-md);
}

.supplier-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.supplier-card {
  transition: all 0.2s ease;
}

.supplier-card:active {
  transform: scale(0.98);
}

.supplier-header {
  margin-bottom: 16rpx;
}

.supplier-type {
  font-size: var(--font-size-xs);
  color: var(--primary-color);
  background: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  display: inline-block;
  margin-bottom: 8rpx;
}

.supplier-name {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.supplier-info {
  margin-bottom: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.info-icon {
  font-size: 24rpx;
}

.supplier-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--bg-secondary);
}

.supplier-price {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.price-label {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

.price-value {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--error-color);
}

.supplier-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  padding: 8rpx 16rpx;
  font-size: 28rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
}

.action-btn.delete {
  background: #FFF1F0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: var(--font-size-lg);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

.fab {
  position: fixed;
  bottom: 160rpx;
  right: 40rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 60rpx;
  font-weight: 300;
  box-shadow: var(--shadow-lg);
  z-index: 100;
}

.fab:active {
  transform: scale(0.95);
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: none;
  align-items: flex-end;
  justify-content: center;
}

.modal.show {
  display: flex;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 100%;
  max-height: 90vh;
  background: white;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  overflow-y: auto;
  animation: slideUp 0.3s ease-out;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid var(--border-color);
  position: sticky;
  top: 0;
  background: white;
  z-index: 1;
}

.modal-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
}

.modal-close {
  font-size: 48rpx;
  color: var(--text-tertiary);
}

.modal-body {
  padding: 32rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid var(--border-color);
  position: sticky;
  bottom: 0;
  background: white;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.cancel {
  background: var(--bg-secondary);
  color: var(--text-secondary);
}

.modal-btn.confirm {
  background: var(--primary-color);
  color: white;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-item.half {
  flex: 1;
}

.form-label {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  box-sizing: border-box;
}

.form-textarea {
  min-height: 120rpx;
  resize: vertical;
}

.type-scroll {
  white-space: nowrap;
}

.type-options {
  display: inline-flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.type-option {
  padding: 12rpx 24rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  white-space: nowrap;
}

.type-option.selected {
  background: var(--primary-color);
  color: white;
}

.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
}

.picker-icon {
  font-size: 32rpx;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
