.page {
  min-height: 100vh;
  background: var(--bg-secondary);
  padding-bottom: 200rpx;
}

.container {
  padding: var(--spacing-md);
}

.section-card {
  margin-bottom: var(--spacing-md);
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.settings-list {
  border-top: 2rpx solid var(--bg-secondary);
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--bg-secondary);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item.danger .label-text {
  color: var(--error-color);
}

.setting-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.label-icon {
  font-size: 32rpx;
}

.label-text {
  font-size: var(--font-size-md);
  color: var(--text-primary);
}

.setting-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-size-md);
  color: var(--text-secondary);
}

.setting-input {
  text-align: right;
  font-size: var(--font-size-md);
  color: var(--text-secondary);
  min-width: 200rpx;
}

.arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.version-text {
  color: var(--text-tertiary);
}

.quick-links {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: var(--spacing-lg);
}

.quick-link {
  background: white;
  border-radius: var(--radius-md);
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: var(--shadow-sm);
}

.quick-link:active {
  transform: scale(0.98);
}

.link-icon {
  font-size: 48rpx;
}

.link-text {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
  text-align: center;
}
