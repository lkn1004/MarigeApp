<view class="page">
  <view class="container">
    <!-- 婚礼信息 -->
    <view class="section-card card">
      <view class="section-header">
        <text class="section-title">💒 婚礼信息</text>
      </view>

      <view class="settings-list">
        <view class="setting-item">
          <view class="setting-label">
            <text class="label-icon">📅</text>
            <text class="label-text">婚礼日期</text>
          </view>
          <picker mode="date" value="{{weddingDate}}" bindchange="onDateChange">
            <view class="setting-value">
              <text>{{weddingDate || '请选择'}}</text>
              <text class="arrow">›</text>
            </view>
          </picker>
        </view>

        <view class="setting-item">
          <view class="setting-label">
            <text class="label-icon">🏨</text>
            <text class="label-text">婚礼场地</text>
          </view>
          <input 
            class="setting-input"
            placeholder="请输入"
            value="{{weddingVenue}}"
            bindblur="onVenueBlur"
          />
        </view>
      </view>
    </view>

    <!-- 新人信息 -->
    <view class="section-card card">
      <view class="section-header">
        <text class="section-title">👰🤵 新人信息</text>
      </view>

      <view class="settings-list">
        <view class="setting-item">
          <view class="setting-label">
            <text class="label-icon">🤵</text>
            <text class="label-text">新郎姓名</text>
          </view>
          <input 
            class="setting-input"
            placeholder="请输入新郎姓名"
            value="{{groomName}}"
            bindblur="onGroomBlur"
          />
        </view>

        <view class="setting-item">
          <view class="setting-label">
            <text class="label-icon">👰</text>
            <text class="label-text">新娘姓名</text>
          </view>
          <input 
            class="setting-input"
            placeholder="请输入新娘姓名"
            value="{{brideName}}"
            bindblur="onBrideBlur"
          />
        </view>
      </view>
    </view>

    <!-- 数据管理 -->
    <view class="section-card card">
      <view class="section-header">
        <text class="section-title">📦 数据管理</text>
      </view>

      <view class="settings-list">
        <view class="setting-item" bindtap="exportData">
          <view class="setting-label">
            <text class="label-icon">📤</text>
            <text class="label-text">导出数据</text>
          </view>
          <view class="setting-value">
            <text class="arrow">›</text>
          </view>
        </view>

        <view class="setting-item danger" bindtap="clearAllData">
          <view class="setting-label">
            <text class="label-icon">🗑️</text>
            <text class="label-text">清除所有数据</text>
          </view>
          <view class="setting-value">
            <text class="arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 关于 -->
    <view class="section-card card">
      <view class="section-header">
        <text class="section-title">ℹ️ 关于</text>
      </view>

      <view class="settings-list">
        <view class="setting-item" bindtap="aboutApp">
          <view class="setting-label">
            <text class="label-icon">💡</text>
            <text class="label-text">关于备婚助手</text>
          </view>
          <view class="setting-value">
            <text class="arrow">›</text>
          </view>
        </view>

        <view class="setting-item">
          <view class="setting-label">
            <text class="label-icon">📱</text>
            <text class="label-text">版本</text>
          </view>
          <view class="setting-value">
            <text class="version-text">v1.0.0</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick-links">
      <view class="quick-link" bindtap="goToSupplier">
        <text class="link-icon">🏪</text>
        <text class="link-text">供应商管理</text>
      </view>
      <view class="quick-link" bindtap="goToGuest">
        <text class="link-icon">👥</text>
        <text class="link-text">宾客管理</text>
      </view>
      <view class="quick-link" bindtap="goToChecklist">
        <text class="link-icon">📋</text>
        <text class="link-text">清单模板</text>
      </view>
    </view>
  </view>
</view>
