.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5E6E8 0%, #F8F8F8 50%, #F5E6E8 100%);
  padding-bottom: 200rpx;
}

.container {
  padding: var(--spacing-md);
}

.main-countdown {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  border-radius: var(--radius-lg);
  padding: 60rpx 40rpx;
  text-align: center;
  color: white;
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-lg);
  position: relative;
  overflow: hidden;
}

.main-countdown::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
  animation: pulse 4s infinite;
}

.countdown-header {
  position: relative;
  z-index: 1;
  margin-bottom: 30rpx;
}

.countdown-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
}

.countdown-title {
  font-size: 32rpx;
  opacity: 0.9;
}

.countdown-date {
  position: relative;
  z-index: 1;
  font-size: 28rpx;
  opacity: 0.8;
  margin-bottom: 30rpx;
}

.countdown-display {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
}

.countdown-unit {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
}

.unit-value {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
  text-shadow: 0 4rpx 20rpx rgba(0,0,0,0.2);
}

.unit-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.unit-separator {
  font-size: 60rpx;
  font-weight: 700;
  opacity: 0.5;
  margin-top: -20rpx;
}

.no-date {
  position: relative;
  z-index: 1;
  padding: 40rpx 0;
}

.no-date-text {
  font-size: var(--font-size-lg);
  opacity: 0.8;
  display: block;
  margin-bottom: 24rpx;
}

.set-date-btn {
  display: inline-block;
  padding: 16rpx 40rpx;
  background: white;
  color: var(--primary-color);
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  border: none;
}

.couple-card {
  margin-bottom: var(--spacing-md);
}

.couple-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.couple-icon {
  font-size: 40rpx;
}

.couple-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.couple-names {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.couple-names .name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.couple-names .and {
  font-size: 36rpx;
  color: var(--primary-color);
}

.venue-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.venue-icon {
  font-size: 24rpx;
}

.upcoming-section {
  margin-bottom: var(--spacing-md);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.view-more {
  font-size: var(--font-size-sm);
  color: var(--primary-color);
}

.event-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.event-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
}

.event-date {
  width: 80rpx;
  text-align: center;
  margin-right: 20rpx;
}

.event-day {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-color);
  display: block;
  line-height: 1;
}

.event-month {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

.event-content {
  flex: 1;
  min-width: 0;
}

.event-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.event-days {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

.priority-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.priority-dot.priority-high {
  background: var(--error-color);
}

.priority-dot.priority-medium {
  background: var(--warning-color);
}

.priority-dot.priority-low {
  background: var(--success-color);
}

.quick-links {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.quick-link {
  background: white;
  border-radius: var(--radius-md);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: var(--shadow-sm);
}

.quick-link:active {
  transform: scale(0.98);
}

.link-icon {
  font-size: 48rpx;
}

.link-text {
  font-size: var(--font-size-md);
  color: var(--text-primary);
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.05);
  }
}
