.page {
  min-height: 100vh;
  background: var(--bg-secondary);
}

.container {
  padding: var(--spacing-md);
}

.form-section {
  background: white;
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-sm);
}

.section-title {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  box-sizing: border-box;
  resize: vertical;
}

.category-scroll {
  white-space: nowrap;
}

.category-tags {
  display: inline-flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.category-tag {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  white-space: nowrap;
  transition: all 0.2s ease;
}

.category-tag.selected {
  color: white;
}

.priority-tags {
  display: flex;
  gap: 16rpx;
}

.priority-tag {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  border-radius: var(--radius-md);
  background: var(--bg-secondary);
  color: var(--text-secondary);
  font-size: var(--font-size-md);
  transition: all 0.2s ease;
}

.priority-tag.selected {
  color: white;
}

.priority-tag.priority-high.selected {
  background: var(--error-color);
}

.priority-tag.priority-medium.selected {
  background: var(--warning-color);
}

.priority-tag.priority-low.selected {
  background: var(--success-color);
}

.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
}

.picker-icon {
  font-size: 32rpx;
}

.form-actions {
  margin-top: var(--spacing-lg);
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: white;
  border: none;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}
