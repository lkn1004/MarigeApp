.page {
  min-height: 100vh;
  background: var(--bg-secondary);
  padding-bottom: 200rpx;
}

.container {
  padding: var(--spacing-md);
}

.overview-card {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  color: white;
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-lg);
}

.overview-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.overview-label {
  font-size: var(--font-size-sm);
  opacity: 0.9;
  display: block;
  margin-bottom: 8rpx;
}

.overview-amount {
  font-size: 56rpx;
  font-weight: 700;
}

.overview-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-label {
  font-size: var(--font-size-sm);
  opacity: 0.8;
  display: block;
  margin-bottom: 4rpx;
}

.stat-value {
  font-size: var(--font-size-xl);
  font-weight: 600;
}

.stat-value.spent {
  color: white;
}

.stat-value.remaining {
  color: #90EE90;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.3);
}

.progress-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-section .progress-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(255,255,255,0.3);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.progress-section .progress-fill {
  height: 100%;
  background: white;
  border-radius: var(--radius-full);
  transition: width 0.5s ease;
}

.progress-section .progress-fill.warning {
  background: #FFD700;
}

.progress-text {
  font-size: var(--font-size-sm);
  font-weight: 600;
  min-width: 80rpx;
  text-align: right;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: var(--spacing-md);
}

.action-btn {
  background: white;
  border-radius: var(--radius-md);
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: var(--shadow-sm);
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn text:first-child {
  font-size: 40rpx;
}

.action-btn text:last-child {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

.section-card {
  margin-bottom: var(--spacing-md);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
}

.category-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.category-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
}

.category-name {
  font-size: var(--font-size-md);
  color: var(--text-primary);
}

.category-amount {
  text-align: right;
}

.spent-amount {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-primary);
}

.planned-amount {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

.empty-category,
.empty-records {
  text-align: center;
  padding: 40rpx;
  color: var(--text-tertiary);
  font-size: var(--font-size-sm);
}

.empty-hint {
  display: block;
  margin-top: 8rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
}

.record-left {
  flex: 1;
  min-width: 0;
}

.record-description {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.record-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-date {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

.record-category {
  padding: 2rpx 10rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
}

.record-right {
  text-align: right;
}

.record-amount {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--error-color);
  display: block;
  margin-bottom: 4rpx;
}

.record-status {
  font-size: var(--font-size-xs);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-full);
}

.record-status.paid {
  background: #E6F7E6;
  color: var(--success-color);
}

.record-status.pending {
  background: #FFF7E6;
  color: var(--warning-color);
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: none;
  align-items: flex-end;
  justify-content: center;
}

.modal.show {
  display: flex;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 100%;
  background: white;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  max-height: 90vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease-out;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid var(--border-color);
  position: sticky;
  top: 0;
  background: white;
  z-index: 1;
}

.modal-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
}

.modal-close {
  font-size: 48rpx;
  color: var(--text-tertiary);
}

.modal-body {
  padding: 32rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid var(--border-color);
  position: sticky;
  bottom: 0;
  background: white;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.cancel {
  background: var(--bg-secondary);
  color: var(--text-secondary);
}

.modal-btn.confirm {
  background: var(--primary-color);
  color: white;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  box-sizing: border-box;
}

.amount-input {
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
}

.category-scroll {
  white-space: nowrap;
}

.category-options {
  display: inline-flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.category-option {
  padding: 12rpx 24rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  white-space: nowrap;
}

.category-option.selected {
  color: white;
}

.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
}

.picker-icon {
  font-size: 32rpx;
}

.status-options {
  display: flex;
  gap: 16rpx;
}

.status-option {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  border-radius: var(--radius-md);
  background: var(--bg-secondary);
  color: var(--text-secondary);
  font-size: var(--font-size-md);
}

.status-option.selected {
  background: var(--primary-color);
  color: white;
}

.template-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.template-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
  border: 3rpx solid transparent;
}

.template-item.selected {
  border-color: var(--primary-color);
  background: var(--primary-light);
}

.template-info {
  flex: 1;
}

.template-name {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.template-amount {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--primary-color);
}

.template-check {
  width: 48rpx;
  height: 48rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
